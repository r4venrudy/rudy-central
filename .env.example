# Set environment variables through your service manager. Node does not auto-load this file.
PORT=4173
HOST=127.0.0.1
# A private key file is generated in .data on first launch; never commit it.
# RUDY_ADMIN_KEY=<at-least-32-random-characters>
# RUDY_VIEWER_KEY=<a-different-32-character-random-value>
# Behind HTTPS set RUDY_SECURE_COOKIE=1 and RUDY_PUBLIC_ORIGIN=https://rudy.example.com
# Remote binding additionally requires RUDY_ALLOW_REMOTE=1 and an HTTPS public origin.
