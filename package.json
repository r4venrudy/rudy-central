{
  "name": "rudy-central",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.mts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node server/index.mts",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "sensor": "node sensors/linux-snapshot.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
